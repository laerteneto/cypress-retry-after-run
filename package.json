{
  "name": "cypress-retry-after-run",
  "version": "1.0.7",
  "description": "Cypress plugin to re-run only failed tests from the previous run using @cypress/grep",
  "main": "index.js",
  "scripts": {
    "test": "pnpm --filter ./examples/cypress-js test:full && pnpm --filter ./examples/cypress-ts test:full",
    "test:js": "pnpm --filter ./examples/cypress-js test:full",
    "test:ts": "pnpm --filter ./examples/cypress-ts test:full"
  },
  "bin": {
    "cypress-retry": "./bin/cypress-retry.js"
  },
  "files": [
    "index.js",
    "bin/**/*",
    "README.md"
  ],
  "keywords": [
    "cypress",
    "plugin",
    "retry",
    "grep",
    "testing",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laerteneto/cypress-retry-after-run.git"
  },
  "bugs": {
    "url": "https://github.com/laerteneto/cypress-retry-after-run/issues"
  },
  "homepage": "https://github.com/laerteneto/cypress-retry-after-run#readme",
  "type": "commonjs",
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "chalk": "6.0.0"
  }
}